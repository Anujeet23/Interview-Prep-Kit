{
  "name": "interview-prep-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Turns a job description + company URL into a researched, editable interview preparation kit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "evaluate": "node server/scripts/evaluate.js",
    "fixtures": "node server/scripts/serve-fixtures.js",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.js\"",
    "demo:api": "node server/test/support/smokeServer.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.76"
  }
}
