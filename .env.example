# ---------- Backend (Express API + batch command) ----------

# At least one LLM key is needed. Free keys:
#   Gemini: https://aistudio.google.com/apikey        (recommended: generous tokens-per-minute)
#   Groq:   https://console.groq.com/keys             (fast; small tokens-per-minute on free tier)
#   OpenRouter (":free" models): https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Order to try providers in. On a spent quota the next one is used. "mock" = offline, deterministic.
LLM_PROVIDERS=gemini,groq
# Model names (check the provider's console for what the free tier currently offers)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Our own pacing, set a little BELOW the provider's free-tier limits
GEMINI_RPM=8
GEMINI_TPM=200000
GROQ_RPM=25
GROQ_TPM=11000

# Optional: better public-discussion search (free tier at https://tavily.com). Without it we use Hacker News + Reddit.
TAVILY_API_KEY=
# Set to false to skip the public-discussion search entirely
DISCUSSION_SEARCH=true

# Web app only (the batch command does not need these)
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep-kit
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
SESSION_DAYS=7
# The frontend's public URL(s), comma-separated (used for CORS and the Origin check)
APP_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# Private/loopback URLs are blocked when NODE_ENV=production. The batch command enables
# them automatically because evaluation sites may be served from localhost.
# ALLOW_PRIVATE_URLS=false

# Tuning (defaults shown)
# CRAWL_MAX_PAGES=8
# CRAWL_TIMEOUT_MS=10000
# PIPELINE_BUDGET_MS=170000
# LLM_MAX_WAIT_MS=120000
